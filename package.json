{
  "name": "corrida-fantasma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVIDOR,JOGO -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --port 5173 --strictPort",
    "dev:server": "cross-env PORT=3001 tsx watch server/index.ts",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "piloto": "tsx scripts/piloto-virtual.ts",
    "fontes": "tsx scripts/baixar-fontes.ts",
    "qrcode": "tsx scripts/qrcode.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "qrcode.react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest",
    "tsx": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "cross-env": "^10.1.0",
    "qrcode": "^1.5.4",
    "typescript": "latest",
    "vitest": "latest"
  }
}
